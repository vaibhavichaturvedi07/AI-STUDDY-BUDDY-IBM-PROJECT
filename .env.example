# ──────────────────────────────────────────────────────────────────────────────
# AI Study Buddy — Environment Configuration
# Copy this file to .env and fill in your values before starting the app.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# Generate a strong SECRET_KEY with: openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────


# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="AI Study Buddy"
APP_VERSION="1.0.0"

# Set DEBUG=False in production. When False:
#   - Swagger UI (/docs) is disabled
#   - Log output is structured JSON
#   - HSTS header is added
DEBUG=False


# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -hex 32
SECRET_KEY="CHANGE-ME-use-openssl-rand-hex-32"

# JWT token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=1440    # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=30


# ── Database ──────────────────────────────────────────────────────────────────
# For Docker Compose: host is the service name "db"
# For local dev: use localhost
DATABASE_URL="postgresql+asyncpg://studybuddy:studybuddy@db:5432/studybuddy"


# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose: "openai" or "watsonx"
AI_PROVIDER="openai"

# ── OpenAI (set AI_PROVIDER=openai) ──────────────────────────────────────────
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ── IBM watsonx.ai (set AI_PROVIDER=watsonx) ─────────────────────────────────
# WATSONX_API_KEY="..."
# WATSONX_PROJECT_ID="..."
# WATSONX_URL="https://us-south.ml.cloud.ibm.com"
# WATSONX_MODEL="meta-llama/llama-3-3-70b-instruct"


# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=20
# Allowed: pdf, txt, md, docx (comma-separated list)
ALLOWED_EXTENSIONS='["pdf","txt","md","docx"]'


# ── CORS ──────────────────────────────────────────────────────────────────────
# For production, restrict to your actual frontend domain(s)
# ALLOWED_ORIGINS='["https://yourdomain.com"]'
# For local development:
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]'


# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Default: 200 requests per minute per IP (adjust as needed)
# Override per-route limits in the route decorators
